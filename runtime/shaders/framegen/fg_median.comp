// Frame generation (runtime/gfx/vk/device/vk_framegen.c): the 3x3 median of the motion vectors, each component on its
// own, so a lone wrong match takes its neighbours' motion. After SkyboundTotk's kMedianWgsl
// (a64-kit/gpu/render/rx_framegen.cpp, https://github.com/NotRexed/SkyboundTotk @
// a4495f95b5e5ab6562d603058dcaa3457d0c8027, MIT, Copyright (c) 2026 NotRexed).
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 3, rg16f) uniform writeonly image2D dst;

// Fixed median selection network: nineteen compare-exchanges, no dynamic loop.
void order(inout vec2 a, inout vec2 b) {
    vec2 lo=min(a,b);b=max(a,b);a=lo;
}
vec2 med9(vec2 v[9]) {
    order(v[1],v[2]);
    order(v[4],v[5]);
    order(v[7],v[8]);
    order(v[0],v[1]);
    order(v[3],v[4]);
    order(v[6],v[7]);
    order(v[1],v[2]);
    order(v[4],v[5]);
    order(v[7],v[8]);
    order(v[0],v[3]);
    order(v[5],v[8]);
    order(v[4],v[7]);
    order(v[3],v[6]);
    order(v[1],v[4]);
    order(v[2],v[5]);
    order(v[4],v[7]);
    order(v[4],v[2]);
    order(v[6],v[4]);
    order(v[4],v[2]);
    return v[4];
}

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, imageSize(dst)))) return;
    ivec2 m = textureSize(src, 0) - 1;
    vec2 values[9];
    for (int i = 0; i < 9; i++) {
        vec2 f = texelFetch(src, clamp(g + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), m), 0).xy;
        values[i] = f;
    }
    imageStore(dst, g, vec4(med9(values), 0.0, 0.0));
}
