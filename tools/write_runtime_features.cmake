if(NOT DEFINED RUNTIME OR NOT EXISTS "${RUNTIME}" OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Runtime feature manifest requires its built executable and output path")
endif()
file(SHA256 "${RUNTIME}" runtime_sha256)
foreach(feature NATIVE_LAN STEAM_DEV)
    if(${feature})
        set(${feature}_JSON true)
    else()
        set(${feature}_JSON false)
    endif()
endforeach()
file(WRITE "${OUTPUT}" "{\n  \"schema\": 1,\n  \"game\": \"${GAME}\",\n  \"runtime_sha256\": \"${runtime_sha256}\",\n  \"features\": {\"native_lan_provider\": ${NATIVE_LAN_JSON}, \"steam_dev_bootstrap\": ${STEAM_DEV_JSON}}\n}\n")
